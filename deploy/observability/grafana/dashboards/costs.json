{
 "uid": "radar-costs",
 "title": "Radar Innowacji — koszty LLM",
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "tags": [
  "radar",
  "koszty"
 ],
 "version": 1,
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Karty bez dużego LLM (cel > 90%)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "radar_cards_without_large_llm_ratio"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.9
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "description": "Udział ocenionych kart, których żadnej części (ekstrakcja, agent oceny) nie napisał duży model w chmurze."
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Szacowany koszt LLM (USD, narastająco)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(radar_llm_cost_usd_total)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "description": "Tokeny × ceny z RADAR_LLM_PRICES (USD za 1M). Model lokalny = 0."
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Chmura włączona",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(radar_llm_cloud_allowed)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "nie"
        },
        "1": {
         "text": "TAK"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background"
   },
   "description": "RADAR_LLM_ALLOW_CLOUD. Domyślnie wyłączona: łańcuch to model lokalny, potem reguły."
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Pregeneracja aktualna",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(radar_pregen_cards{state=\"current\"}) / sum(radar_pregen_cards)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.99
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background"
   },
   "description": "Karty z aktualną treścią z radar pregenerate (brief, hasło, wycena, odbiorcy); API tylko ją czyta."
  },
  {
   "id": 5,
   "type": "piechart",
   "title": "Karty wg najdroższego użytego modelu",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 8,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (path) (radar_cards_by_llm_path)",
     "legendFormat": "{{path}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "values": [
      "value",
      "percent"
     ]
    },
    "pieType": "donut"
   },
   "description": "rules = Basal + reguły/heurystyka, local = mały model na CPU, cloud = duży model w chmurze."
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Wywołania LLM wg dostawcy (/min)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 5,
    "w": 16,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (provider) (rate(radar_llm_requests_total[5m])) * 60",
     "legendFormat": "{{provider}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 7,
   "type": "bargauge",
   "title": "Wywołania LLM wg dostawcy i celu (łącznie)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (provider, purpose) (radar_llm_requests_total)",
     "legendFormat": "{{provider}} · {{purpose}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Szacowany koszt wg dostawcy (USD)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (provider) (radar_llm_cost_usd_total)",
     "legendFormat": "{{provider}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Tokeny wg dostawcy",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (provider, direction) (radar_llm_tokens_total)",
     "legendFormat": "{{provider}} {{direction}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 10,
   "type": "piechart",
   "title": "Hasła: reguły vs mały model",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 22,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (by) (radar_pregen_slogans)",
     "legendFormat": "{{by}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "pieType": "pie"
   }
  },
  {
   "id": 11,
   "type": "bargauge",
   "title": "Stan pregeneracji",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 22,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (state) (radar_pregen_cards)",
     "legendFormat": "{{state}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  }
 ],
 "description": "Zasada kosztów (#13): reguły i mały model lokalny domyślnie, duży model w chmurze tylko po jawnym włączeniu."
}