# Plain HTTP edge behind Cloudflare Tunnel (docker compose --profile tunnel up -d). Cloudflare terminates TLS,
# so no certificate here; the same private paths as deploy/public/Caddyfile stay hidden from the internet.
:80 {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	@private path /metrics /api/basal/train
	respond @private 404
	# regenerating a guide's narration spends time on the shared llama.cpp server: operator only, never from
	# the internet (the UI never sends `fresh`; the API also requires the operator token when one is set)
	@fresh_pitch {
		path /api/cards/*/pitch
		expression {query.fresh} != ""
	}
	respond @fresh_pitch 403
	reverse_proxy api:8000
}
