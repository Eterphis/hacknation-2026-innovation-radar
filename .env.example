# Skopiuj do .env i uzupełnij (plik .env nie trafia do repozytorium ani do obrazu).

# Port przeglądarki danych na komputerze (http://localhost:8765)
RADAR_PORT=8765

# Co ile godzin kontener `scheduler` odświeża dane (pierwsze odświeżenie zaraz po starcie)
REFRESH_INTERVAL_HOURS=24

# Dodatkowe opcje dla każdego odświeżenia, np. "--delay 2" albo "--sources interreg"
REFRESH_ARGS=

# Klucz API Claude dla kart innowacji (bez niego karty liczone są offline, na regułach)
ANTHROPIC_API_KEY=
# auto | claude | offline
RADAR_LLM=auto
