# ===== app/ (API, kolejka, workery: docker compose up) =====
# Skopiuj do .env. Bez kluczy aplikacja działa w trybie demo.
RADAR_DEMO_MODE=1
RADAR_LLM_PROVIDERS=anthropic,openai,mock
RADAR_ANTHROPIC_API_KEY=
RADAR_ANTHROPIC_MODEL=claude-sonnet-5-5
RADAR_OPENAI_API_KEY=
RADAR_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAIRE_TOKEN=
# Sekret HMAC dla webhooka źródła `zgloszenia` (pusty = endpoint otwarty, tylko dev)
RADAR_WEBHOOK_SECRET_ZGLOSZENIA=

# ===== harvester (radar/ w katalogu głównym: docker compose --profile harvester up) =====
# Skopiuj do .env i uzupełnij (plik .env nie trafia do repozytorium ani do obrazu).

# Port przeglądarki danych na komputerze (http://localhost:8765)
HARVESTER_PORT=8765

# Co ile minut kontener `scheduler` sprawdza terminy źródeł i uruchamia te, którym minął
# (`refresh --due-only`; terminy: radar/refresh.py REGISTRY i config/sites.json). Pierwsze sprawdzenie od razu.
REFRESH_TICK_MINUTES=60

# Dodatkowe opcje dla każdego odświeżenia, np. "--delay 2" albo "--category nauka projekty"
REFRESH_ARGS=

# Klucz API Claude dla kart innowacji (bez niego karty liczone są offline, na regułach)
ANTHROPIC_API_KEY=
# auto | claude | offline
RADAR_LLM=auto

# OpenAlex (prace z afiliacją w Polsce): darmowy klucz z https://openalex.org/settings/api.
# Bez klucza konektor pobiera mały wycinek (5 stron) i nie kończy się błędem przy limicie 429.
OPENALEX_API_KEY=
OPENALEX_MAILTO=
