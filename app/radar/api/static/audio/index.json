 "intro-ada": {
  "file": "intro-ada.mp3",
  "guide": "ada",
  "text": "Cześć, tu Ada. Pokazuję pomysły oczami inwestora: gotowość inwestycyjną, ochronę własności intelektualnej i wartość licencji. Wejdź w pomysł i kliknij „Posłuchaj”.",
  "voice": "ElevenLabs: Kasia"
 },
 "intro-ola": {
  "file": "intro-ola.mp3",
  "guide": "ola",
  "text": "Cześć, tu Ola. Szukam dla szkół sprawdzonych programów, które łatwo powtórzyć u siebie. Wejdź w pomysł, a opowiem Ci o nim.",
  "voice": "ElevenLabs: Emilia"
 },
 "intro-profesor": {
  "file": "intro-profesor.mp3",
  "guide": "profesor",
  "text": "Dzień dobry, tu Profesor Marek. Pomagam uczelniom znaleźć partnerów, z którymi wyniki badań trafią na rynek.",
  "voice": "ElevenLabs: Gabriel"
 },
 "intro-radek": {
  "file": "intro-radek.mp3",
  "guide": "radek",
  "text": "Cześć, tu Radek. Pomagam znaleźć polskie innowacje, które warto wdrożyć. Wejdź w dowolny pomysł i kliknij „Posłuchaj”, a opowiem Ci o nim.",
  "voice": "ElevenLabs: Karol"
 },
 "intro-tomek": {
  "file": "intro-tomek.mp3",
  "guide": "tomek",
  "text": "Cześć, tu Tomek. Pomagam samorządom i wykonawcom policzyć, ile kosztuje wdrożenie u siebie, kiedy się zwróci i skąd wziąć na nie pieniądze.",
  "voice": "ElevenLabs: Maciej"
 }
}